# Application
NEXT_PUBLIC_APP_URL=https://gyvft.vercel.app/
NODE_ENV=development
IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Public website (required for form email delivery)
# The public site does NOT require Supabase or DATABASE_URL.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=aarla@aarla.in
RESEND_FROM_NAME=GYVFT by Aarla
GYVFT_LEADS_EMAIL=aarla@aarla.in

# ---------------------------------------------------------------------------
# Optional analytics (public tags load only after consent)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
META_ACCESS_TOKEN=
META_DATASET_ID=

# ---------------------------------------------------------------------------
# Studio / backend only (optional — not required for the public website)
# ---------------------------------------------------------------------------
# Database (Supabase Session Pooler URI recommended for Vercel)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Auth / Storage for Studio
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy JWT keys (deprecated; temporary fallback only)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secret encryption (min 32 chars). Required for Studio-managed secrets.
INTEGRATION_ENCRYPTION_KEY=replace_with_a_long_random_secret_key_32+

# Optional Studio AI fallback
OPENAI_API_KEY=

# Uploads (Studio / brief size guard)
MAX_UPLOAD_BYTES=10485760
DEFAULT_CURRENCY=INR

# Cron endpoints (Studio ops)
CRON_SECRET=replace_with_long_random_cron_secret
