# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
IS_PRODUCTION=false

# Database (Supabase Session Pooler URI recommended for Vercel)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Preferred current keys (Settings → API Keys → Publishable and secret API keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy JWT keys (deprecated; temporary fallback only — prefer the keys above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secret encryption (min 32 chars). Required for Studio-managed secrets.
INTEGRATION_ENCRYPTION_KEY=replace_with_a_long_random_secret_key_32+

# Optional environment-managed integration fallbacks
# Precedence: Studio encrypted secret (if present) > environment variable
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@gyvft.com
RESEND_FROM_NAME=GYVFT
OPENAI_API_KEY=
META_ACCESS_TOKEN=
META_DATASET_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Uploads
MAX_UPLOAD_BYTES=10485760
DEFAULT_CURRENCY=INR

# Cron endpoints
CRON_SECRET=replace_with_long_random_cron_secret
